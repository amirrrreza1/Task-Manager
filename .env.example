# PostgreSQL
POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=change-me-database-password
# Docker Compose (in-container hostname `database`):
DATABASE_URL=postgresql://task_manager:change-me-database-password@database:5432/task_manager?schema=public
# Local CLI against Docker Postgres (default host port 15432 in compose.override.yaml):
# DATABASE_URL=postgresql://task_manager:change-me-database-password@localhost:15432/task_manager?schema=public

# Bootstrap administrator (used only to create/update the protected admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_DAYS=30

# Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional explicit socket server URL. By default, derived from NEXT_PUBLIC_API_URL.
# For production reverse proxies, set this if WebSockets are handled by a dedicated endpoint.
NEXT_PUBLIC_SOCKET_URL=
CORS_ORIGIN=http://localhost:3000
# Public web URL used in email/Telegram "View Task" links. Telegram cannot open
# localhost or private-IP links from a phone; use an https:// hostname in production.
APP_PUBLIC_URL=http://localhost:3000
# Public workspace appearance and calendar. Rebuild web (`docker compose up -d --build web`) after changing NEXT_PUBLIC_* variables.
# Set NEXT_PUBLIC_CALENDAR to `gregorian` or `solar` (Solar Hijri / Persian calendar).
NEXT_PUBLIC_CALENDAR=gregorian
NEXT_PUBLIC_COMPANY_NAME="Task Manager"
NEXT_PUBLIC_COMPANY_ICON=/icon.svg

# File storage
STORAGE_DRIVER=local
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_SIZE_MB=25

# SMTP email notifications (optional). Restart the API after changing these.
# Quote values that contain spaces, for example SMTP_PASSWORD="xxxx xxxx xxxx xxxx".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Task Manager"

# Telegram group notifications (optional). Restart the API after changing these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional topic thread ID (for supergroups with topics/forum enabled). Leave empty to post to the main chat.
TELEGRAM_MESSAGE_THREAD_ID=
# Optional proxy for Telegram requests (supports HTTP, HTTPS, SOCKS5, e.g. socks5://127.0.0.1:1080 or http://user:pass@proxy:8080)
TELEGRAM_PROXY_URL=

