generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum EstimateMode {
  TIME
  POINTS
}

enum EstimateUnit {
  HOURS
  POINTS
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum AttachmentOwnerType {
  TASK
  SUBTASK
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  username          String              @unique @db.VarChar(64)
  displayName       String              @db.VarChar(100)
  color             String              @db.VarChar(9)
  passwordHash      String
  role              UserRole            @default(MEMBER)
  email             String?             @unique @db.VarChar(255)
  telegramUsername  String?             @db.VarChar(64)
  avatarStorageKey  String?             @db.VarChar(64)
  avatarMimeType    String?             @db.VarChar(127)
  hasAvatar         Boolean             @default(false)
  isActive          Boolean             @default(true)
  isBootstrapAdmin  Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  taskAssignments   TaskAssignment[]
  assignedSubtasks  Subtask[]           @relation("SubtaskAssignee")
  sprintComments    SprintComment[]
  activityEvents    ActivityEvent[]      @relation("ActivityActor")
  createdTasks      Task[]               @relation("TaskCreator")
  createdSubtasks   Subtask[]            @relation("SubtaskCreator")
  uploadedFiles     Attachment[]         @relation("AttachmentUploader")
  refreshSessions   RefreshSession[]
  notifications     Notification[]       @relation("NotificationRecipient")
  triggeredNotifications Notification[]  @relation("NotificationActor")

  @@index([isActive])
}

model Workspace {
  id                    String        @id @default(uuid()) @db.Uuid
  name                  String        @db.VarChar(120)
  description           String?       @db.Text
  estimateMode          EstimateMode  @default(TIME)
  sprintDurationDays    Int           @default(14)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  columns               BoardColumn[]
  sprints               Sprint[]
  tasks                 Task[]
  projects              Project[]
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  name        String    @db.VarChar(120)
  key         String?   @db.VarChar(16)
  description String?   @db.Text
  color       String?   @db.VarChar(9)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model AppSettings {
  id                    String       @id @default("default") @db.VarChar(32)
  estimateMode          EstimateMode @default(TIME)
  sprintDurationDays    Int          @default(14)
  revision              Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model BoardColumn {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  name        String    @db.VarChar(80)
  color       String    @db.VarChar(9)
  position    Int
  isBacklog   Boolean   @default(false)
  isTodo      Boolean   @default(false)
  isDone      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  subtasks    Subtask[]

  @@unique([workspaceId, position])
}

model Sprint {
  id               String                   @id @default(uuid()) @db.Uuid
  workspaceId      String                   @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  name             String                   @db.VarChar(120)
  goal             String?                  @db.Text
  status           SprintStatus             @default(PLANNED)
  startsAt         DateTime?
  endsAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks            Task[]
  subtasks         Subtask[]
  comments         SprintComment[]
  taskSnapshots    SprintTaskSnapshot[]
  subtaskSnapshots SprintSubtaskSnapshot[]

  @@index([workspaceId, status])
  @@index([startsAt, endsAt])
}

model SprintTaskSnapshot {
  id            String       @id @default(uuid()) @db.Uuid
  sprintId      String       @db.Uuid
  taskId        String?      @db.Uuid
  title         String       @db.VarChar(240)
  estimateValue Int?
  estimateUnit  EstimateUnit?
  columnName    String       @db.VarChar(80)
  wasDone       Boolean
  completedAt   DateTime     @default(now())
  sprint        Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([sprintId, taskId])
  @@index([sprintId, wasDone])
}

model SprintSubtaskSnapshot {
  id              String       @id @default(uuid()) @db.Uuid
  sprintId        String       @db.Uuid
  subtaskId       String?      @db.Uuid
  taskId          String?      @db.Uuid
  taskTitle       String       @db.VarChar(240)
  title           String       @db.VarChar(240)
  estimateValue   Int?
  estimateUnit    EstimateUnit?
  wasDone         Boolean
  completedAt     DateTime     @default(now())
  sprint          Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  subtask         Subtask?     @relation(fields: [subtaskId], references: [id], onDelete: SetNull)

  @@unique([sprintId, subtaskId])
  @@index([sprintId, wasDone])
}

model SprintComment {
  id        String   @id @default(uuid()) @db.Uuid
  body      String   @db.Text
  sprintId  String   @db.Uuid
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sprint    Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([sprintId, createdAt])
}

model Task {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  projectId       String?              @db.Uuid
  title           String               @db.VarChar(240)
  description     String?              @db.Text
  priority        TaskPriority         @default(MEDIUM)
  estimateValue   Int?
  estimateUnit    EstimateUnit?
  position        Decimal              @default(0) @db.Decimal(20, 10)
  columnId        String               @db.Uuid
  sprintId        String?              @db.Uuid
  createdById     String               @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  column          BoardColumn          @relation(fields: [columnId], references: [id], onDelete: Restrict)
  sprint          Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees       TaskAssignment[]
  subtasks        Subtask[]
  attachments     Attachment[]
  sprintSnapshots SprintTaskSnapshot[]

  @@index([workspaceId, columnId, position])
  @@index([workspaceId, projectId])
  @@index([workspaceId, priority])
  @@index([columnId, position])
  @@index([sprintId])
  @@index([updatedAt])
}

model TaskAssignment {
  taskId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
}

model Subtask {
  id             String       @id @default(uuid()) @db.Uuid
  taskId         String       @db.Uuid
  columnId       String       @db.Uuid
  sprintId       String?      @db.Uuid
  title          String       @db.VarChar(240)
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  estimateValue  Int?
  estimateUnit   EstimateUnit?
  isCompleted    Boolean      @default(false)
  position       Int          @default(0)
  assigneeId     String?      @db.Uuid
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  column         BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Restrict)
  sprint         Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("SubtaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attachments    Attachment[]
  sprintSnapshots SprintSubtaskSnapshot[]

  @@index([taskId, position])
  @@index([columnId, position])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([priority])
}

model Attachment {
  id           String              @id @default(uuid()) @db.Uuid
  ownerType    AttachmentOwnerType
  taskId       String?             @db.Uuid
  subtaskId    String?             @db.Uuid
  storageKey   String              @unique
  originalName String              @db.VarChar(255)
  mimeType     String              @db.VarChar(127)
  sizeBytes    BigInt
  checksum     String              @db.VarChar(64)
  uploadedById String              @db.Uuid
  createdAt    DateTime            @default(now())
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtask      Subtask?            @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  uploadedBy   User                @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([subtaskId])
  @@index([uploadedById])
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  familyId    String   @db.Uuid
  userId      String   @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// Captured from day one so v2 activity logs and personal reports do not need
// to reconstruct history from current records.
model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.Uuid
  actorId    String?  @db.Uuid
  payload    Json
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

// Transactional outbox for future email/Telegram reports and backup notices.
model OutboxMessage {
  id          String   @id @default(uuid()) @db.Uuid
  topic       String   @db.VarChar(100)
  payload     Json
  availableAt DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([processedAt, availableAt])
}

model NotificationConfig {
  id              String   @id @default("default") @db.VarChar(32)
  smtpEnabled     Boolean  @default(false)
  telegramEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  actorId      String?  @db.Uuid
  type         String   @db.VarChar(64)
  title        String   @db.VarChar(255)
  message      String   @db.Text
  link         String?  @db.VarChar(255)
  isRead       Boolean  @default(false)
  emailSent    Boolean  @default(false)
  telegramSent Boolean  @default(false)
  createdAt    DateTime @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}
