generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum EstimateMode {
  TIME
  POINTS
}

enum EstimateUnit {
  MINUTES
  POINTS
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum AttachmentOwnerType {
  TASK
  SUBTASK
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  username          String              @unique @db.VarChar(64)
  displayName       String              @db.VarChar(100)
  passwordHash      String
  role              UserRole            @default(MEMBER)
  avatarSeed        String              @db.VarChar(64)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  taskAssignments   TaskAssignment[]
  assignedSubtasks  Subtask[]           @relation("SubtaskAssignee")
  sprintComments    SprintComment[]
  activityEvents    ActivityEvent[]      @relation("ActivityActor")
  createdTasks      Task[]               @relation("TaskCreator")
  createdSubtasks   Subtask[]            @relation("SubtaskCreator")
  refreshSessions   RefreshSession[]

  @@index([isActive])
}

model AppSettings {
  id                    String       @id @default("default") @db.VarChar(32)
  estimateMode          EstimateMode @default(TIME)
  sprintDurationDays    Int          @default(14)
  revision              Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model BoardColumn {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(80)
  color       String   @db.VarChar(9)
  position    Int
  isDone      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@unique([position])
}

model Sprint {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(120)
  goal        String?         @db.Text
  status      SprintStatus    @default(PLANNED)
  startsAt    DateTime?
  endsAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       Task[]
  comments    SprintComment[]

  @@index([status])
  @@index([startsAt, endsAt])
}

model SprintComment {
  id        String   @id @default(uuid()) @db.Uuid
  body      String   @db.Text
  sprintId  String   @db.Uuid
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sprint    Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([sprintId, createdAt])
}

model Task {
  id             String           @id @default(uuid()) @db.Uuid
  title          String           @db.VarChar(240)
  description    String?          @db.Text
  estimateValue  Int?
  estimateUnit   EstimateUnit?
  position       Decimal          @default(0) @db.Decimal(20, 10)
  columnId       String           @db.Uuid
  sprintId       String?          @db.Uuid
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  column         BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Restrict)
  sprint         Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees      TaskAssignment[]
  subtasks       Subtask[]
  attachments    Attachment[]

  @@index([columnId, position])
  @@index([sprintId])
  @@index([updatedAt])
}

model TaskAssignment {
  taskId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
}

model Subtask {
  id             String       @id @default(uuid()) @db.Uuid
  taskId         String       @db.Uuid
  title          String       @db.VarChar(240)
  description    String?      @db.Text
  estimateValue  Int?
  estimateUnit   EstimateUnit?
  isCompleted    Boolean      @default(false)
  position       Int          @default(0)
  assigneeId     String?      @db.Uuid
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("SubtaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attachments    Attachment[]

  @@index([taskId, position])
  @@index([assigneeId])
}

model Attachment {
  id           String              @id @default(uuid()) @db.Uuid
  ownerType    AttachmentOwnerType
  taskId       String?             @db.Uuid
  subtaskId    String?             @db.Uuid
  storageKey   String              @unique
  originalName String              @db.VarChar(255)
  mimeType     String              @db.VarChar(127)
  sizeBytes    BigInt
  checksum     String              @db.VarChar(64)
  createdAt    DateTime            @default(now())
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtask      Subtask?            @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([subtaskId])
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  userId      String   @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Captured from day one so v2 activity logs and personal reports do not need
// to reconstruct history from current records.
model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.Uuid
  actorId    String?  @db.Uuid
  payload    Json
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

// Transactional outbox for future email/Telegram reports and backup notices.
model OutboxMessage {
  id          String   @id @default(uuid()) @db.Uuid
  topic       String   @db.VarChar(100)
  payload     Json
  availableAt DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([processedAt, availableAt])
}
